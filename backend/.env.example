POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=lavan_dev
POSTGRES_USER=lavan_dev
POSTGRES_PASSWORD=replace-with-a-generated-local-password

# Host execution only; defaults to ~/.local/share/lavan/artifacts.
# Must be an absolute dedicated directory outside the repository.
# ARTIFACT_STORAGE_DIR=/absolute/private/artifact-directory
# Compose uses its private named volume at /var/lib/lavan/artifacts.
ZIP_MAX_COMPRESSED_BYTES=52428800
ZIP_MAX_UNCOMPRESSED_BYTES=209715200
ZIP_MAX_ENTRIES=2000
ZIP_MAX_FILE_BYTES=52428800
ZIP_MAX_FILENAME_CHARS=512
UPLOAD_MAX_SECONDS=60
UPLOAD_MAX_ACTIVE=2
